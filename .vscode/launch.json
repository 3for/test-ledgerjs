    "version": "0.2.0",
    "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Vue (Vite) in Chrome",
      "url": "http://localhost:5173",       // Vite 默认端口
      "webRoot": "${workspaceFolder}/src",  // Vue 源码根目录
      "sourceMaps": true,
      "trace": true                           // 可选，用于调试断点映射问题
    }
    ]
}